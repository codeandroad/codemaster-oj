      }
    },
    {
      "id": "q3",
      "number": 3,
      "type": "single",
      "topic": {
        "en": "Prefix/Infix/Postfix Notation",
        "zh": "前缀／中缀／后缀表达式"
      },
      "statement": {
        "en": "Convert the following infix expression to prefix:\n\n$$\n\\frac{(5-1)\\cdot(4+8)}{7^2-5^2}\n$$",
        "zh": "请将以下中缀表达式转换为前缀表达式:\n\n$$\n\\frac{(5-1)\\cdot(4+8)}{7^2-5^2}\n$$"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "`/-*51+48-^72^52`",
            "zh": "`/-*51+48-^72^52`"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "`*-/51+48^-72^52`",
            "zh": "`*-/51+48^-72^52`"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "`/*-51+48-^7252^`",
            "zh": "`/*-51+48-^7252^`"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "`/*-51+48-^72^52`",
            "zh": "`/*-51+48-^72^52`"
          }
        },
        {
          "id": "E",
          "text": {
            "en": "`*/-51+48-^72^52`",
            "zh": "`*/-51+48-^72^52`"
          }
        }
      ],
      "correctOptionIds": [
        "D"
      ],
      "explanation": {
        "en": "Answer: **D**.\n\n((− 5 1) * (+ 4 8)) / ((^ 7 2) − (^ 5 2)) = (* − 5 1 + 4 8) / (− ^ 7 2 ^ 5 2) = / * − 5 1 + 4 8 − ^ 7 2 ^ 5 2",
        "zh": "答案：**D**。\n\n分数线将整道式子分成分子与分母。分子 $(5-1)(4+8)$ 写成 `* - 5 1 + 4 8`，分母 $7^2-5^2$ 写成 `- ^ 7 2 ^ 5 2`。在两段前加上除号，得到 `/ * - 5 1 + 4 8 - ^ 7 2 ^ 5 2`。"
      },
