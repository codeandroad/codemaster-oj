  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "single",
      "topic": {
        "en": "Computer Number Systems",
        "zh": "计算机数字系统"
      },
      "statement": {
        "en": "Convert $1B8_{16}$ to base 10.",
        "zh": "请将 $1B8_{16}$ 转换为十进制数。"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "335",
            "zh": "335"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "409",
            "zh": "409"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "430",
            "zh": "430"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "440",
            "zh": "440"
          }
        },
        {
          "id": "E",
          "text": {
            "en": "450",
            "zh": "450"
          }
        }
      ],
      "correctOptionIds": [
        "D"
      ],
      "explanation": {
        "en": "Answer: **D**.\n\nThe place values in $1B8_{16}$ are $16^2$, $16$, and $1$. The letter B represents eleven, so $1\\cdot256+11\\cdot16+8=440$.",
        "zh": "答案：**D**。\n\n$1B8_{16}$ 从左到右的位权是 $16^2$、$16$、$1$，B 表示十一。因此 $1\\times256+11\\times16+8=440$。"
      },
