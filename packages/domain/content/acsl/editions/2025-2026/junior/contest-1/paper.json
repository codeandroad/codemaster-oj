      "statement": {
        "en": "What is the average of the following two numbers in base 10?\n\n$$\n36_{8}\\qquad 74_{8}\n$$",
        "zh": "以下两个数在十进制下的平均值是多少？\n\n$$\n36_{8}\\qquad 74_{8}\n$$"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "36",
            "zh": "36"
          }
        },
        {
          "id": "B",
