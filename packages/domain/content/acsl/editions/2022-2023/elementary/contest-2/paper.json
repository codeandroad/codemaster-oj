          1
        ],
        "answerProvenance": "official"
      }
    },
    {
      "id": "q2",
      "number": 2,
      "type": "single",
      "topic": {
        "en": "Prefix/Infix/Postfix Notation",
        "zh": "前缀／中缀／后缀表达式"
      },
      "statement": {
        "en": "Evaluate the following prefix expression if all numbers are single digits:\n\n`/ - + * 3 7 / 8 2 ^ 5 2 9`",
        "zh": "如果下方所有数字都是一个单独的数值,请计算下方前缀表达式:\n\n`/ - + * 3 7 / 8 2 ^ 5 2 9`"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "9",
            "zh": "9"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "6",
            "zh": "6"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "3",
            "zh": "3"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "1",
            "zh": "1"
          }
        },
        {
          "id": "E",
          "text": {
            "en": "0",
            "zh": "0"
          }
        }
      ],
      "correctOptionIds": [
        "E"
      ],
      "explanation": {
        "en": "Answer: **E**.\n\n`/ - + * 3 7 / 8 2 ^ 5 2 9 = / - + (3 * 7) (8 / 2) (5 ^ 2) 9`\n\n= / − + 21 4 25 9 = / − (21 + 4) 25 9 = / − 25 25 9 = / (25 − 25) 9 = / 0 9 = (0 / 9) = 0",
        "zh": "答案：**E**。\n\n最外层除法的右操作数为 9。分子依次算 $3\\times7=21$、$8/2=4$、$5^2=25$，再得 $(21+4)-25=0$。所以 $0/9=0$。"
      },
      "source": {
