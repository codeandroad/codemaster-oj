# Copy to deploy/.env. Generate each secret independently with openssl rand -hex 32.
# DNS for this host must point at the school server; Caddy provisions HTTPS.
CAMPUS_HOST=oj.example.edu
APP_ORIGIN=https://oj.example.edu
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_SECRET
APP_DB_PASSWORD=REPLACE_WITH_RANDOM_APP_DATABASE_SECRET
WORKER_DB_PASSWORD=REPLACE_WITH_RANDOM_WORKER_DATABASE_SECRET
SESSION_SECRET=REPLACE_WITH_RANDOM_SESSION_SECRET
JUDGE_AUTH_TOKEN=REPLACE_WITH_ANOTHER_RANDOM_SECRET
# Defaults suit 30–50 concurrent students on 4 cores / 16 GiB. Queue capacity
# is controlled by API limits; do not scale workers without capacity testing.
WORKER_CONCURRENCY=2
WORKER_NODE_ID=judge-node-01
# Optional: only enable after confirming the immediate API proxy's exact
# source address/CIDR. Keep empty to ignore caller-supplied forwarding headers.
TRUSTED_PROXY_CIDRS=
