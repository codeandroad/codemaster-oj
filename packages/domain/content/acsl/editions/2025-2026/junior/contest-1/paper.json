      "id": "q1",
      "number": 1,
      "type": "single",
      "topic": {
        "en": "Computer Number Systems",
        "zh": "计算机数字系统"
      },
      "statement": {
        "en": "Convert $52326_{16}$ to octal.",
        "zh": "将 $52326_{16}$ 转换为8进制。"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "336677",
            "zh": "336677"
          }
        },
        {
          "id": "B",
          "text": {
