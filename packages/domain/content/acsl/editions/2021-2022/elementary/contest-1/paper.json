  "questions": [
    {
      "id": "q1",
      "number": 1,
      "type": "single",
      "topic": {
        "en": "Computer Number Systems",
        "zh": "计算机数字系统"
      },
      "statement": {
        "en": "Convert $147_{8}$ to base 10.",
        "zh": "请将 $147_{8}$ 转化为十进制。"
      },
      "options": [
        {
          "id": "A",
          "text": {
            "en": "481",
            "zh": "481"
          }
        },
        {
          "id": "B",
          "text": {
            "en": "120",
            "zh": "120"
          }
        },
        {
          "id": "C",
          "text": {
            "en": "114",
            "zh": "114"
          }
        },
        {
          "id": "D",
          "text": {
            "en": "103",
            "zh": "103"
          }
        },
        {
          "id": "E",
          "text": {
            "en": "93",
            "zh": "93"
          }
        }
      ],
      "correctOptionIds": [
        "D"
      ],
      "explanation": {
        "en": "Answer: **D**.\n\nTo convert $147_{8}$ to base 10, take powers of 8 times each digit in the number:\n\n$$\n7+4*8+1*64=7+32+64=103_{10}\n$$",
        "zh": "答案：**D**。\n\n从右到左，三个位置的权分别为 $8^0$、$8^1$、$8^2$。$147_8=1\\times64+4\\times8+7=103_{10}$。"
      },
      "source": {
        "statementSource": "statement",
