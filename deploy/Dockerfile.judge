FROM criyle/go-judge:v1.13.2@sha256:250251b4d13325e411b6dfbe153daa67b25122a22301ef06e1f4ad5b64a01f6d AS executor
FROM node:22-trixie-slim@sha256:154ba2f4d6fec323d28e4f4bb86bba4677f1223391a1979cf521304e03a98dfa AS node_runtime
FROM python:3.12-slim-trixie@sha256:a6e34c598f2467ed0e9a8d349809fcd8b5c603269512df273a0bb1784edc11b1
# Debian 13 supplies Clang 19 and GCC 14 libstdc++ as a matched toolchain.
# Python 3.12 remains pinned for every existing published problem/version.
RUN apt-get update && apt-get install -y --no-install-recommends \
    clang-19 g++-14 libstdc++-14-dev nlohmann-json3-dev \
    && rm -rf /var/lib/apt/lists/*
COPY --from=node_runtime /usr/local/bin/node /usr/local/bin/node
COPY --from=executor /opt/go-judge /opt/go-judge
COPY deploy/judge-mount.yaml /opt/mount.yaml
COPY deploy/judge-seccomp.yaml /opt/seccomp.yaml
WORKDIR /opt
ENTRYPOINT ["/opt/go-judge"]
CMD ["-http-addr=:5050", "-parallelism=2", "-container-cred-start=10000", "-net-share=false", "-no-fallback", "-silent", "-mount-conf=/opt/mount.yaml", "-seccomp-conf=/opt/seccomp.yaml", "-output-limit=1m", "-copy-out-limit=8m", "-file-timeout=2m"]
